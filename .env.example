# Copy to .env (which is gitignored) and fill in real values.
# Server reads this on startup. Never exposed to browser (except /api/config keys).

# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# ── Optional: override express port (defaults to 5173). ──────────────
# PORT=3001

# ── Microsoft Entra ID (Azure AD) SSO ────────────────────────────────
# Register an app in Azure portal → App registrations → New registration.
# Single-tenant Goldbell only. Redirect URI: http://localhost:5173 (dev) + prod URL.
# Expose an API → set Application ID URI (default api://<clientId>) →
# add scope "access_as_user" → grant admin consent.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Audience the backend will accept. Default: api://${ENTRA_CLIENT_ID}
# ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# Full scope string the browser asks for at login. Default: api://${ENTRA_CLIENT_ID}/access_as_user
# ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Pinned redirect URI for MSAL. Must match the SPA redirect in Azure portal.
# In dev, leave blank to fall back to window.location.origin. In prod, REQUIRED.
ENTRA_REDIRECT_URI=

# Set to "true" to bypass SSO locally (dev only — never in prod).
# Server refuses to boot if AUTH_DISABLED=true AND NODE_ENV=production.
AUTH_DISABLED=false

# ── MSSQL (chat history persistence) ─────────────────────────────────
MSSQL_SERVER=GBITR01V.goldbell.com.sg
MSSQL_DATABASE=AIFramework
MSSQL_USER=ReadUser
MSSQL_PASSWORD=replace-me
# Use "true" only if your SQL Server requires TLS (default false matches existing apps).
MSSQL_ENCRYPT=false
